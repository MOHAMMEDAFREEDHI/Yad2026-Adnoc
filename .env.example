# -- Frontend -----------------------------------------------
# Leave empty to use the simulated MockVotingService (local development).
# Set to the API base URL to use the real API. Same-origin deployment: leave "" and use "/" via VITE_VOTE_API_URL=/
VITE_VOTE_API_URL=

# -- Backend (server-only; NEVER prefix with VITE_) ---------
# Provide either DATABASE_URL or the PG* variables. Real values go in .env (git-ignored) or host secrets.
DATABASE_URL=
# PGHOST=your-instance.xxxxxxxx.region.rds.amazonaws.com
# PGPORT=5432
# PGDATABASE=postgres
# PGUSER=
# PGPASSWORD=

# TLS to RDS. DB_SSL=true by default. Provide the AWS RDS CA bundle for full verification
# (https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem).
DB_SSL=true
DB_SSL_CA_PATH=
# Only set to false as a last resort while diagnosing certificate issues.
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10

# Verified CHECK constraint values:
#   events.status:    draft | open | closed
#   questions.status: draft | active | closed
EVENT_OPEN_STATUS=open
QUESTION_ACTIVE_STATUS=active

# Repeat-voting policy. Only "unrestricted" is implemented (idempotency still prevents double-delivery).
VOTE_POLICY=unrestricted

# Comma-separated allowed browser origins for CORS (empty = same-origin only).
CORS_ALLOWED_ORIGINS=
# Votes per IP per minute / reads per IP per minute.
RATE_LIMIT_VOTES_PER_MIN=30
RATE_LIMIT_READS_PER_MIN=120
